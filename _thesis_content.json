{
  "cover": {
    "uni": "\u6e29\u5dde\u5927\u5b66",
    "course": "\u6570\u636e\u53ef\u89c6\u5316\u8bfe\u7a0b\u8bba\u6587",
    "title": "\u57fa\u4e8eRFM\u6a21\u578b\u7684\u7535\u5546\u7528\u6237\u6d88\u8d39\u884c\u4e3a\u6570\u636e\u53ef\u89c6\u5316\u4e0eStreamlit\u4ea4\u4e92\u5f0f\u5206\u6790\u7cfb\u7edf",
    "cls": "24\u6570\u636e\u79d11",
    "name": "\u5218\u8fdc\u8f89",
    "sid": "24211870125"
  },
  "abstract": "\u968f\u7740\u7535\u5b50\u5546\u52a1\u7684\u5feb\u901f\u53d1\u5c55\uff0c\u6d77\u91cf\u7528\u6237\u6d88\u8d39\u6570\u636e\u7684\u80cc\u540e\u8574\u542b\u7740\u4e30\u5bcc\u7684\u7528\u6237\u884c\u4e3a\u6a21\u5f0f\u4e0e\u5546\u4e1a\u4ef7\u503c\u3002\u672c\u8bba\u6587\u4ee5\u96f6\u552e\u7535\u5546\u5e73\u53f0\u8ba2\u5355\u6570\u636e\u4e3a\u7814\u7a76\u5bf9\u8c61\uff0c\u56f4\u7ed5\u6570\u636e\u9884\u5904\u7406\u3001\u63cf\u8ff0\u6027\u7edf\u8ba1\u5206\u6790\u3001RFM\u7528\u6237\u4ef7\u503c\u5efa\u6a21\u3001K-Means\u805a\u7c7b\u5206\u6790\u548cStreamlit\u4ea4\u4e92\u5f0f\u53ef\u89c6\u5316\u7cfb\u7edf\u5f00\u53d1\u4e94\u4e2a\u6838\u5fc3\u73af\u8282\uff0c\u6784\u5efa\u4e86\u5b8c\u6574\u7684\u7535\u5546\u7528\u6237\u6d88\u8d39\u884c\u4e3a\u5206\u6790\u4f53\u7cfb\u3002\u672c\u7814\u7a76\u8868\u660e\uff0c\u6570\u636e\u53ef\u89c6\u5316\u6280\u672f\u4e0e\u673a\u5668\u5b66\u4e60\u65b9\u6cd5\u7684\u6709\u6548\u7ed3\u5408\uff0c\u80fd\u591f\u4e3a\u7535\u5546\u5e73\u53f0\u7684\u7cbe\u7ec6\u5316\u8fd0\u8425\u548c\u7528\u6237\u4ef7\u503c\u7ba1\u7406\u63d0\u4f9b\u79d1\u5b66\u7684\u51b3\u7b56\u652f\u6301\u3002",
  "keywords": "\u6570\u636e\u53ef\u89c6\u5316\uff1bRFM\u6a21\u578b\uff1bK-Means\u805a\u7c7b\uff1bStreamlit\uff1b\u7528\u6237\u884c\u4e3a\u5206\u6790",
  "ch1": {
    "bg": "\u968f\u7740\u4e92\u8054\u7f51\u6280\u672f\u7684\u8fc5\u731b\u53d1\u5c55\uff0c\u7535\u5b50\u5546\u52a1\u5df2\u6210\u4e3a\u73b0\u4ee3\u6d88\u8d39\u7684\u4e3b\u8981\u6e20\u9053\u4e4b\u4e00\u3002\u636e\u7edf\u8ba1\uff0c2024\u5e74\u4e2d\u56fd\u7535\u5546\u5e02\u573a\u4ea4\u6613\u89c4\u6a21\u7a81\u7834\u5341\u4e07\u4ebf\u5143\uff0c\u65e5\u5747\u4ea7\u751f\u4ebf\u7ea7\u522b\u7684\u7528\u6237\u884c\u4e3a\u6570\u636e\u3002\u8fd9\u4e9b\u6d77\u91cf\u6570\u636e\u80cc\u540e\u8574\u85cf\u7740\u7528\u6237\u7684\u6d88\u8d39\u504f\u597d\u3001\u884c\u4e3a\u89c4\u5f8b\u548c\u4ef7\u503c\u5dee\u5f02\uff0c\u5982\u4f55\u4ece\u4e2d\u63d0\u53d6\u6709\u6548\u4fe1\u606f\u3001\u6316\u6398\u5546\u4e1a\u6d1e\u5bdf\uff0c\u6210\u4e3a\u4f01\u4e1a\u548c\u7814\u7a76\u8005\u5173\u6ce8\u7684\u7126\u70b9\u95ee\u9898\u3002\u4f20\u7edf\u7684\u4f01\u4e1a\u6570\u636e\u5206\u6790\u65b9\u6cd5\u5f80\u5f80\u4f9d\u8d56\u4e8eExcel\u8868\u683c\u548c\u7b80\u5355\u7684\u7edf\u8ba1\u62a5\u8868\uff0c\u96be\u4ee5\u5e94\u5bf9\u6d77\u91cf\u3001\u591a\u7ef4\u3001\u5b9e\u65f6\u7684\u6570\u636e\u5206\u6790\u9700\u6c42\uff0c\u5b58\u5728\u6570\u636e\u5904\u7406\u6548\u7387\u4f4e\u3001\u5206\u6790\u89c6\u89d2\u5355\u4e00\u3001\u7ed3\u679c\u5448\u73b0\u4e0d\u76f4\u89c2\u7b49\u75db\u70b9\u3002",
    "theory": "\u4ece\u7406\u8bba\u610f\u4e49\u6765\u770b\uff0cRFM\u6a21\u578b\u662f\u5ba2\u6237\u5173\u7cfb\u7ba1\u7406\u9886\u57df\u7684\u7ecf\u5178\u7406\u8bba\u6846\u67b6\uff0c\u901a\u8fc7\u6700\u8fd1\u6d88\u8d39\u65f6\u95f4\u3001\u6d88\u8d39\u9891\u6b21\u548c\u6d88\u8d39\u91d1\u989d\u4e09\u4e2a\u7ef4\u5ea6\u5bf9\u7528\u6237\u4ef7\u503c\u8fdb\u884c\u5b9a\u91cf\u8bc4\u4f30\u3002\u5c06RFM\u6a21\u578b\u4e0eK-Means\u805a\u7c7b\u7b97\u6cd5\u76f8\u7ed3\u5408\uff0c\u53ef\u4ee5\u5b9e\u73b0\u5bf9\u7528\u6237\u7684\u81ea\u52a8\u5316\u5206\u5c42\uff0c\u514b\u670d\u4f20\u7edf\u4eba\u5de5\u5206\u7c7b\u7684\u4e3b\u89c2\u6027\u548c\u5c40\u9650\u6027\uff0c\u4e30\u5bcc\u4e86\u7528\u6237\u884c\u4e3a\u5206\u6790\u7684\u7406\u8bba\u65b9\u6cd5\u4f53\u7cfb\u3002",
    "practice": "\u4ece\u5b9e\u9645\u5e94\u7528\u610f\u4e49\u6765\u770b\uff0c\u901a\u8fc7\u6784\u5efa\u4ea4\u4e92\u5f0f\u6570\u636e\u53ef\u89c6\u5316\u7cfb\u7edf\uff0c\u4f01\u4e1a\u7ecf\u8425\u8005\u53ef\u4ee5\u76f4\u89c2\u5730\u67e5\u770b\u7528\u6237\u6d88\u8d39\u8d8b\u52bf\u3001\u54c1\u7c7b\u8868\u73b0\u548c\u7528\u6237\u5206\u5c42\u7ed3\u679c\uff0c\u4ece\u800c\u5236\u5b9a\u66f4\u7cbe\u51c6\u7684\u8425\u9500\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u9488\u5bf9\u9ad8\u4ef7\u503c\u7528\u6237\u63d0\u4f9bVIP\u670d\u52a1\uff0c\u5bf9\u6f5c\u5728\u6d41\u5931\u7528\u6237\u53d1\u9001\u4f18\u60e0\u5238\u5524\u56de\uff0c\u5b9e\u73b0\u7cbe\u7ec6\u5316\u8fd0\u8425\uff0c\u63d0\u5347\u7528\u6237\u7559\u5b58\u7387\u548c\u7ecf\u8425\u6548\u76ca\u3002\u672c\u7814\u7a76\u5f00\u53d1\u7684Streamlit\u53ef\u89c6\u5316\u7cfb\u7edf\u5177\u5907\u5b9e\u7528\u6027\u5f3a\u3001\u53ef\u6269\u5c55\u6027\u597d\u7684\u7279\u70b9\uff0c\u53ef\u76f4\u63a5\u5e94\u7528\u4e8e\u5b9e\u9645\u4e1a\u52a1\u573a\u666f\u3002"
  }
}